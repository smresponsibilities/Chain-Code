# Chain-Code backend environment variables
# Copy to .env and fill in. Never commit real values.

# --- Core ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/chaincode

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
# JWTs expire after 7d (hardcoded). Rotate JWT_SECRET to invalidate all sessions.

# --- Code execution (judge) ---
EXECUTION_PROVIDER=rapidapi          # rapidapi | selfhosted
JUDGE=judge0
SELFHOSTED_JUDGE0_URL=                # e.g. https://judge0.yourdomain.com when self-hosting
JUDGE0_AUTHN_TOKEN=                   # must match AUTHN_TOKEN in deploy/judge0/judge0.conf
RAPIDAPI_KEY=                         # kept as fallback: used if EXECUTION_PROVIDER=selfhosted and the box is down
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
EXECUTE_RATE_LIMIT=20                # executions per user per minute

# --- Originality judge (multi-provider fallback chain) ---
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
ZAI_API_KEY=
ZAI_MODEL=
# Fail behavior when ALL providers are down:
#   false (default) = fail closed, submissions rejected with 503
#   true            = fail open (old permissive behavior)
ORIGINALITY_FAIL_OPEN=false

# --- On-chain (Sepolia testnet) ---
PRIVATE_KEY=                         # platform minting wallet
CONTRACT_ADDRESS=                    # NFT certificate contract
GOV_CONTRACT_ADDRESS=                # governance contract
API=                                 # blockchain RPC/API base
FALLBACK_API=                        # fallback RPC/API base

# public URLs for ERC-721 metadata (tokenURI)
PUBLIC_BACKEND_URL=
PUBLIC_FRONTEND_URL=
